</style>


<!-- Initialize Swiper -->
  <script>
  var swiper = new Swiper(".mySwiper", {
    slidesPerView: 2,
    spaceBetween: 35,
    pagination: {
      el: ".swiper-pagination",
      clickable: true,
    },
    centeredSlides: true, // this enables centered slides
    loop: true, // enables infinite looping
    autopay: {
    delay: 2000, // time between slides in milliseconds
    disableOnInteraction: false, // keeps autoplay going after manual nav
    },
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
    breakpoints: {
      0: {
        slidesPerView: 1,
        spaceBetween: 20,
      },
      768: {
        slidesPerView: 1.5,
        spaceBetween: 20,
      },
      1024: {
        slidesPerView: 2,
        spaceBetween: 15,
      },
      1280: {
        slidesPerView: 2,
        spaceBetween: 20,
      },}
  });
  </script>