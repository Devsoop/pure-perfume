<script>
 let currentIndex = 0;
  let frames = [];

  function setMainImage(thumb, index = null) {
    const mainImage = document.getElementById("mainImage");
    const thumbnails = document.querySelectorAll(".thumbnail");

    mainImage.src = thumb.getAttribute("data-full");

    thumbnails.forEach(img => img.classList.remove("active"));
    thumb.classList.add("active");

    currentIndex = index !== null ? index : [...thumbnails].indexOf(thumb);
  }

  function navigateImage(direction) {
    const thumbnails = document.querySelectorAll(".thumbnail");
    if (thumbnails.length === 0) return;

    if (direction === "left") {
      currentIndex = (currentIndex - 1 + thumbnails.length) % thumbnails.length;
    } else {
      currentIndex = (currentIndex + 1) % thumbnails.length;
    }

    setMainImage(thumbnails[currentIndex], currentIndex);
  }

  // On load, store frames and activate first
  document.addEventListener("DOMContentLoaded", () => {
    const thumbnails = document.querySelectorAll(".thumbnail");
    frames = [...thumbnails];
    if (frames.length) {
      setMainImage(frames[0], 0);
    }
  });


  
 const perfumeModal = document.getElementById('perfume-modal');
  const chooseButtons = document.querySelectorAll('.choose-perfume-slot');
  const priceNew = document.querySelector('.new-priceovic');
  const priceOld = document.querySelector('.old-priceovic');
  const priceSaved = document.querySelector('.percentage-saved');

  const buttonBuyMain = document.getElementById('button-buy-main');
  const form = document.getElementById('bundle-form');

  let currentSlotIndex = null;
  const selectedPerfumes = [null, null, null]; // 



  // Open modal
  chooseButtons.forEach((btn, index) => {
    btn.addEventListener('click', () => {
      currentSlotIndex = index;
      perfumeModal.style.display = 'flex';
    });
  });

  // Close modal when clicking outside
  perfumeModal.addEventListener('click', (e) => {
    if (e.target === perfumeModal) {
      perfumeModal.style.display = 'none';
    }
  });

  // Close modal via close button
  document.getElementById('modal-close-button')?.addEventListener('click', () => {
    perfumeModal.style.display = 'none';
  });

  // Perfume selection
  document.querySelectorAll('.perfume-option').forEach(option => {
    option.addEventListener('click', () => {
      const name = option.dataset.name;
      const img = option.dataset.img;

      // Save selected perfume
      selectedPerfumes[currentSlotIndex] = { name, img };

      // Update UI of the button slot
      const button = chooseButtons[currentSlotIndex];
      button.innerHTML = `
        <img src="${img}" alt="Perfume" width="100%" class="ordinary-parfumee-2">
        <span>${name}</span>
      `;
      button.classList.add('slot-selected');
      button.style.borderRadius = "4px";
      button.style.border = "1px solid #C3B490";
      button.style.background = "#FFF8E8";

      // Update pricing and form
      updatePricing();
      updatePerfumeForm();

      // Close modal
      perfumeModal.style.display = 'none';
    });
  });



  // Tab switching logic
const tabButtons = document.querySelectorAll('.tab-button');
const tabContents = document.querySelectorAll('.tab-content');

tabButtons.forEach(button => {
  button.addEventListener('click', () => {
    const targetTab = button.dataset.tab;

    // Toggle button styles
    tabButtons.forEach(btn => btn.classList.remove('active'));
    button.classList.add('active');

    // Show matching tab content
    tabContents.forEach(content => {
      if (content.dataset.tab === targetTab) {
        content.style.display = 'grid';
      } else {
        content.style.display = 'none';
      }
    });

    // Clear search input when switching tabs (optional)
    document.getElementById('perfume-search').value = '';
    document.querySelectorAll('.perfume-option').forEach(item => item.style.display = '');
  });
});

  document.getElementById('perfume-search').addEventListener('input', function () {
  const searchTerm = this.value.toLowerCase();
  const activeTab = document.querySelector('.tab-content[style*="display: grid"]');
  const perfumeItems = activeTab.querySelectorAll('.perfume-option');

  perfumeItems.forEach(item => {
    const name = item.dataset.name.toLowerCase();
    item.style.display = name.includes(searchTerm) ? '' : 'none';
  });
});

 function updatePricing() {
  const count = selectedPerfumes.filter(p => p !== null).length;

  const fullSetPrice = 69.95;
  const pricePerUnit = fullSetPrice / 3;
  const basePrice = 210;

  const calculatedPrice = (pricePerUnit * count).toFixed(2);
  const savedAmount = ((1 - (calculatedPrice / basePrice)) * 100).toFixed(0);

  priceNew.textContent = `€${calculatedPrice}`;
  priceOld.textContent = `€${basePrice.toFixed(2)}`;
  priceSaved.textContent = `BESPAAR ${savedAmount}%`;

  const btnPriceNew = document.querySelector('.price-new');
  const btnPriceOld = document.querySelector('.price-old');

  // Update pricing inside button or show prompt based on selection count
  if (btnPriceNew && btnPriceOld) {
    if (count === 0) {
      btnPriceNew.textContent = `Selecteer eerste parfum`;
      btnPriceOld.textContent = ``;
    } else if (count === 1) {
      btnPriceNew.textContent = `Selecteer tweede parfum`;
      btnPriceOld.textContent = ``;
    } else if (count === 2) {
      btnPriceNew.textContent = `Selecteer derde parfum`;
      btnPriceOld.textContent = ``;
    } else if (count === 3) {
      btnPriceNew.textContent = `In winkelwagen  |  €${calculatedPrice}`;
      btnPriceOld.textContent = `€${basePrice.toFixed(2)}`;
    }
  }

  // Enable button only if all 3 perfumes are selected
  buttonBuyMain.disabled = count !== 3;
}

  function updatePerfumeForm() {
    // Inject into hidden inputs for line item properties
    document.getElementById('perfume1').value = selectedPerfumes[0]?.name || 'Niet geselecteerd';
    document.getElementById('perfume2').value = selectedPerfumes[1]?.name || 'Niet geselecteerd';
    document.getElementById('perfume3').value = selectedPerfumes[2]?.name || 'Niet geselecteerd';
  }

document.addEventListener('DOMContentLoaded', () => {
  buttonBuyMain.disabled = true;

  // 🎯 Gift selection logic (Dutch version)
  let selectedGift = null;

  const giftInput = document.getElementById('free-gift-selected');

  document.querySelectorAll('.gift-select-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      // Remove active state from all
      document.querySelectorAll('.gift-select-btn').forEach(b => {
        b.style.border = '1px dashed #aaa';
        b.style.background = '#fff';
      });

      // Set selected
      selectedGift = btn.dataset.gift;
      btn.style.border = '2px solid #C3B490';
      btn.style.background = '#FFF8E8';

      // Inject into form hidden input
      giftInput.value = selectedGift;
    });
  });

  // ✅ Default select Verleid Hem – Liefdesparfum
  const defaultGiftBtn = document.querySelector('.gift-select-btn[data-gift="Verleid Hem – Liefdesparfum"]');
  if (defaultGiftBtn && giftInput) {
    defaultGiftBtn.click(); // trigger same logic as above
  }

  selectedPerfumes[0] = {
  name: "{{ all_products['572'].title | escape }}",
  img: "{{ all_products['572'].featured_image | image_url: width: 300 }}"
};

selectedPerfumes[1] = {
  name: "{{ all_products['sauvage'].title | escape }}",
  img: "{{ all_products['sauvage'].featured_image | image_url: width: 300 }}"
};

selectedPerfumes[2] = {
  name: "{{ all_products['732'].title | escape }}",
  img: "{{ all_products['732'].featured_image | image_url: width: 300 }}"
};
  
  // Odmah ažuriraj hidden inpute i pricing:
  updatePerfumeForm();
  updatePricing();
  buttonBuyMain.disabled = false;
});
  

</script>