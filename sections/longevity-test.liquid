{%- style -%}
  .longevity-{{ section.id }} {
    --lt-bg: {{ section.settings.background }};
    --lt-heading: {{ section.settings.heading_color }};
    --lt-text: {{ section.settings.text_color }};
    --lt-accent: {{ section.settings.accent_color }};
    --lt-card-bg: {{ section.settings.card_background }};
    --lt-card-text: {{ section.settings.card_text_color }};
    --lt-card-muted: {{ section.settings.card_muted_color }};
    --lt-bar: {{ section.settings.bar_color | default: '#666666' }};
    --lt-button-text: {{ section.settings.button_text_color }};
    --lt-pad-top: {{ section.settings.padding_top }}px;
    --lt-pad-bottom: {{ section.settings.padding_bottom }}px;
  }

  .longevity-{{ section.id }} .longevity__button {
    {%- assign lt_accent = section.settings.accent_color -%}
    {%- assign lt_btn_text = section.settings.button_text_color %}
    --color-button: {{ lt_accent.red }}, {{ lt_accent.green }}, {{ lt_accent.blue }};
    --color-button-text: {{ lt_btn_text.red }}, {{ lt_btn_text.green }}, {{ lt_btn_text.blue }};
  }
{%- endstyle -%}

<div class="longevity longevity-{{ section.id }}">
  <div class="longevity__inner page-width">
    {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
      <h2 class="longevity__heading">
        {%- if section.settings.heading != blank -%}
          <span>{{ section.settings.heading | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading_accent != blank -%}
          <em class="longevity__heading-accent">{{ section.settings.heading_accent | escape }}</em>
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="longevity__text rte">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="longevity__card">
      {%- if section.settings.card_label != blank -%}
        <p class="longevity__label">{{ section.settings.card_label | escape }}</p>
      {%- endif -%}

      <div class="longevity__bars">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'bar' -%}
              <div class="longevity__row{% if block.settings.highlight %} longevity__row--winner{% endif %}" {{ block.shopify_attributes }}>
                <div class="longevity__row-head">
                  <div>
                    <p class="longevity__name">{{ block.settings.name | escape }}</p>
                    {%- if block.settings.subtext != blank -%}
                      <p class="longevity__sub">{{ block.settings.subtext | escape }}</p>
                    {%- endif -%}
                  </div>
                  <span class="longevity__value">{{ block.settings.value | escape }}</span>
                </div>
                <div class="longevity__track">
                  <div class="longevity__fill" style="--lt-fill: {{ block.settings.fill }}%;">
                    {%- if block.settings.highlight and block.settings.badge != blank -%}
                      <span class="longevity__badge">{{ block.settings.badge | escape }}</span>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- when 'callout' -%}
              {%- if block.settings.text != blank -%}
                <div class="longevity__callout rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.button_label != blank -%}
      <a
        class="longevity__button button button--full-width"
        href="{{ section.settings.button_link | default: '#MainProduct' }}"
        {% if section.settings.button_link == blank %}data-longevity-scroll{% endif %}
      >
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('.longevity-{{ section.id }}');
    if (!root) return;

    var scrollLink = root.querySelector('[data-longevity-scroll]');
    if (scrollLink) {
      scrollLink.addEventListener('click', function (event) {
        var target = document.querySelector('[id^="MainProduct-"]');
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    if (!('IntersectionObserver' in window)) {
      root.classList.add('longevity--animated');
      return;
    }
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          root.classList.add('longevity--animated');
          observer.disconnect();
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(root.querySelector('.longevity__card'));
  })();
</script>

{% stylesheet %}
  .longevity {
    background: var(--lt-bg);
    padding: var(--lt-pad-top) 0 var(--lt-pad-bottom);
  }

  .longevity .longevity__inner {
    max-width: 68rem;
    box-sizing: content-box;
  }

  .longevity .longevity__inner > * {
    box-sizing: border-box;
  }

  .longevity__heading {
    margin: 0 0 1.6rem;
    color: var(--lt-heading);
    font-size: clamp(3rem, 5vw, 4.4rem);
    line-height: 1.1;
  }

  .longevity__heading > span,
  .longevity__heading-accent {
    display: block;
  }

  .longevity__heading-accent {
    color: var(--lt-accent);
    font-style: italic;
  }

  .longevity__text {
    margin: 0 0 2.8rem;
    color: var(--lt-text);
    font-size: 1.5rem;
    line-height: 1.7;
  }

  .longevity__text p {
    margin: 0;
  }

  .longevity__text strong {
    color: var(--lt-heading);
  }

  .longevity__card {
    border-radius: 1.2rem;
    padding: 3.2rem 2rem 2.4rem;
    background: var(--lt-card-bg);
    color: var(--lt-card-text);
  }

  .longevity__label {
    margin: 0 0 2rem;
    text-align: center;
    color: var(--lt-accent);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .longevity__bars {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .longevity__row-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.6rem;
    margin-bottom: 1rem;
  }

  .longevity__name {
    margin: 0;
    font-family: var(--font-heading-family);
    color: var(--lt-card-text);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .longevity__sub {
    margin: 0.2rem 0 0;
    color: var(--lt-card-muted);
    font-size: 1.2rem;
    line-height: 1.4;
  }

  .longevity__value {
    flex-shrink: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--lt-card-text);
  }

  .longevity__row--winner .longevity__value {
    color: var(--lt-accent);
  }

  .longevity__track {
    height: 2.2rem;
    border-radius: 99rem;
    background: color-mix(in srgb, var(--lt-card-text) 12%, transparent);
    overflow: hidden;
  }

  .longevity__row--winner .longevity__track {
    height: 3rem;
  }

  .longevity__fill {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: var(--lt-bar);
    transition: width 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .longevity__row--winner .longevity__fill {
    background: var(--lt-accent);
    transition-delay: 0.25s;
  }

  .longevity--animated .longevity__fill {
    width: var(--lt-fill);
  }

  .longevity__badge {
    padding: 0 1.4rem;
    color: var(--lt-button-text);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.4s ease 1.2s;
  }

  .longevity--animated .longevity__badge {
    opacity: 1;
  }

  .longevity__callout {
    margin-top: 0.4rem;
    padding: 1.4rem 1.6rem;
    border-left: 0.3rem solid var(--lt-accent);
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--lt-card-text) 7%, transparent);
    color: var(--lt-card-text);
    font-size: 1.4rem;
    line-height: 1.55;
  }

  .longevity__callout p {
    margin: 0;
  }

  .longevity__callout strong {
    color: var(--lt-accent);
  }

  .longevity__button {
    margin-top: 2.8rem;
    font-size: 1.6rem;
    font-weight: 600;
  }

  @media screen and (min-width: 750px) {
    .longevity__card {
      padding: 3.2rem 2rem 2.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .longevity__fill,
    .longevity__badge {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
