<script>
  const perfumeTabButtons = document.querySelectorAll('.perfume-tab-button');
  const perfumeContents = document.querySelectorAll('.perfume-tab-content');

  perfumeTabButtons.forEach(button => {
    button.addEventListener('click', () => {
      // Remove active classes
      perfumeTabButtons.forEach(btn => btn.classList.remove('is-active'));
      perfumeContents.forEach(content => content.classList.remove('is-visible'));

      // Add to clicked
      button.classList.add('is-active');
      const targetId = button.getAttribute('data-tab');
      document.getElementById(targetId).classList.add('is-visible');
    });
  });
</script>