<script>
    var swiper = new Swiper(".vascuFlowSlider3", {
    slidesPerView: 4,
    spaceBetween: 46,
    pagination: {
      el: ".swiper-pagination3",
      clickable: true,
    },
    navigation: {
        nextEl: '.swiper-button-next3',
        prevEl: '.swiper-button-prev3',
      },
    breakpoints: {
      0: {
        slidesPerView: 1,
        spaceBetween: 15,
      },
      599: {
        slidesPerView: 3,
        spaceBetween: 20,
      },
      992: {
        slidesPerView: 4,
        spaceBetween: 20,
      },
      1150: {
        slidesPerView: 4,
        spaceBetween: 30,
      },
      1600: {
        slidesPerView: 4,
        spaceBetween: 45,
      },
    }
  });


  function handleCustomVideoPlay(video) {
    const wrapper = video.closest('.video-wrapper');
    const icon = wrapper?.querySelector('.custom-play-icon');

    // toggle state
    if (video.paused) {
      video.play();
      if (icon) icon.style.display = 'none';
    } else {
      video.pause();
      if (icon) icon.style.display = 'block';
    }

    // also hide icon when playing via controls or autoplay
    video.addEventListener('play', () => {
      if (icon) icon.style.display = 'none';
    });

    video.addEventListener('pause', () => {
      if (!video.ended && icon) icon.style.display = 'block';
    });

    video.addEventListener('ended', () => {
      if (icon) icon.style.display = 'block';
    });
  }
</script>