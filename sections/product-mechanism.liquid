{%- liquid
  assign pm_id = '#shopify-section-' | append: section.id
  assign pm_video = section.settings.video
  assign pm_image = section.settings.image
  assign pm_video_url = section.settings.video_url | strip

  assign pm_poster = blank
  if pm_image != blank
    assign pm_poster = pm_image | image_url: width: 1400
  elsif pm_video != blank and pm_video.preview_image != blank
    assign pm_poster = pm_video.preview_image | image_url: width: 1400
  endif

  assign pm_has_video = false
  if pm_video != blank or pm_video_url != blank
    assign pm_has_video = true
  endif

  if section.settings.mobile_media_ratio == 'square'
    assign pm_ratio = '1 / 1'
  else
    assign pm_ratio = '4 / 3'
  endif
-%}

{%- style -%}
  {{ pm_id }} {
    --pm-accent: {{ section.settings.accent_color }};
    --pm-icon-bg: {{ section.settings.icon_bg_color }};
    --pm-heading: {{ section.settings.heading_color }};
    --pm-media-bg: {{ section.settings.media_bg }};
    --pm-icon-border: color-mix(in srgb, var(--pm-accent) 25%, #ffffff);
  }

  {{ pm_id }} .pm-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  {{ pm_id }} .pm-container {
    box-sizing: border-box;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  {{ pm_id }} .pm-container *,
  {{ pm_id }} .pm-container *::before,
  {{ pm_id }} .pm-container *::after {
    box-sizing: border-box;
  }

  {{ pm_id }} .pm-card {
    display: flex;
    min-height: 520px;
    overflow: hidden;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.07);
  }

  {{ pm_id }} .pm-card--media-right {
    flex-direction: row-reverse;
  }

  {{ pm_id }} .pm-media {
    position: relative;
    flex: 0 0 50%;
    min-height: 100%;
    background: var(--pm-media-bg);
  }

  {{ pm_id }} .pm-media video,
  {{ pm_id }} .pm-media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  {{ pm_id }} .pm-content {
    flex: 0 0 50%;
    display: flex;
    align-items: center;
  }

  {{ pm_id }} .pm-content__inner {
    width: 100%;
    max-width: 500px;
    padding: 48px;
  }

  {{ pm_id }} .pm-eyebrow {
    margin: 0 0 12px;
    color: var(--pm-accent);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  {{ pm_id }} .pm-heading {
    margin: 0 0 16px;
    color: var(--pm-heading);
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
  }

  {{ pm_id }} .pm-description {
    margin: 0 0 28px;
    color: #000000;
    font-size: 14px;
    line-height: 1.6;
  }

  {{ pm_id }} .pm-description p {
    margin: 0 0 0.8em;
  }

  {{ pm_id }} .pm-description p:last-child {
    margin-bottom: 0;
  }

  {{ pm_id }} .pm-features {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  {{ pm_id }} .pm-feature {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  {{ pm_id }} .pm-feature__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--pm-icon-border);
    background: var(--pm-icon-bg);
    color: var(--pm-accent);
  }

  {{ pm_id }} .pm-feature__icon svg,
  {{ pm_id }} .pm-feature__icon img {
    display: block;
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  {{ pm_id }} .pm-feature__title {
    margin: 0 0 4px;
    color: var(--pm-heading);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
  }

  {{ pm_id }} .pm-feature__text {
    margin: 0;
    color: rgba(0, 0, 0, 0.65);
    font-size: 13px;
    line-height: 1.5;
  }

  @media screen and (max-width: 989px) {
    {{ pm_id }} .pm-container {
      padding: 0 16px;
    }

    {{ pm_id }} .pm-card,
    {{ pm_id }} .pm-card--media-right {
      flex-direction: column;
      min-height: 0;
    }

    {{ pm_id }} .pm-media {
      flex: none;
      width: 100%;
      aspect-ratio: {{ pm_ratio }};
    }

    {{ pm_id }} .pm-content {
      flex: none;
    }

    {{ pm_id }} .pm-content__inner {
      max-width: none;
      padding: 24px;
    }

    {{ pm_id }} .pm-heading {
      font-size: 26px;
    }
  }
{%- endstyle -%}

<div class="pm-section">
  <div class="pm-container">
    <div class="pm-card{% if section.settings.media_position == 'right' %} pm-card--media-right{% endif %}">
      <div class="pm-media">
        {%- if pm_has_video -%}
          <video
            class="pm-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-hidden="true"
            tabindex="-1"
            {% if pm_poster != blank %}
              poster="{{ pm_poster }}"
            {% endif %}
          >
            {%- if pm_video != blank -%}
              {%- for source in pm_video.sources -%}
                {%- if source.mime_type == 'video/mp4' -%}
                  <source src="{{ source.url }}" type="video/mp4">
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <source src="{{ pm_video_url | escape }}" type="video/mp4">
            {%- endif -%}
          </video>
        {%- elsif pm_image != blank -%}
          {{
            pm_image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '375, 550, 750, 990, 1100, 1400',
              sizes: '(min-width: 1400px) 700px, (min-width: 990px) 50vw, 100vw',
              alt: pm_image.alt
          }}
        {%- endif -%}
      </div>

      <div class="pm-content">
        <div class="pm-content__inner">
          {%- if section.settings.eyebrow != blank -%}
            <p class="pm-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="pm-heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <div class="pm-description">{{ section.settings.description }}</div>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <ul class="pm-features" role="list">
              {%- for block in section.blocks -%}
                <li class="pm-feature" {{ block.shopify_attributes }}>
                  <span class="pm-feature__icon" aria-hidden="true">
                    {%- if block.settings.custom_icon != blank -%}
                      {{
                        block.settings.custom_icon
                        | image_url: width: 80
                        | image_tag: loading: 'lazy', widths: '40, 80', sizes: '20px', alt: ''
                      }}
                    {%- else -%}
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        focusable="false"
                      >
                        {%- case block.settings.icon -%}
                          {%- when 'molecule' -%}
                            <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/>
                          {%- when 'clock' -%}
                            <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
                          {%- when 'drop' -%}
                            <path d="M12 2.7l5.7 5.7a8 8 0 1 1-11.3 0z"/>
                          {%- when 'leaf' -%}
                            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10z"/><path d="M2 21c0-3 1.9-5.4 5.1-6 2.4-.5 4.9-2 5.9-3"/>
                          {%- when 'shield' -%}
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>
                          {%- when 'sparkle' -%}
                            <path d="M12 3l1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2z"/><path d="M19 17v4M17 19h4"/>
                          {%- when 'check' -%}
                            <circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/>
                          {%- when 'heart' -%}
                            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/>
                        {%- endcase -%}
                      </svg>
                    {%- endif -%}
                  </span>
                  <div class="pm-feature__body">
                    {%- if block.settings.title != blank -%}
                      <h3 class="pm-feature__title">{{ block.settings.title | escape }}</h3>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <p class="pm-feature__text">{{ block.settings.text | escape }}</p>
                    {%- endif -%}
                  </div>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- if pm_has_video -%}
  <script>
    (function () {
      var video = document.querySelector('{{ pm_id }} .pm-video');
      if (!video || !window.matchMedia) return;
      var query = window.matchMedia('(prefers-reduced-motion: reduce)');

      function apply() {
        if (query.matches) {
          video.removeAttribute('autoplay');
          video.pause();
          // Reloading resets playback so the poster frame shows again.
          video.load();
        } else if (video.paused) {
          video.play().catch(function () {});
        }
      }

      apply();
      if (query.addEventListener) {
        query.addEventListener('change', apply);
      } else if (query.addListener) {
        query.addListener(apply);
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Product mechanism",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Plays muted on loop. Overrides the image."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (MP4) fallback",
      "info": "Used only when no video is selected above."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Poster / image",
      "info": "Shown as the video poster, or on its own when there is no video."
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_media_ratio",
      "label": "Mobile media ratio",
      "options": [
        { "value": "landscape", "label": "4:3" },
        { "value": "square", "label": "1:1" }
      ],
      "default": "landscape"
    },
    {
      "type": "color",
      "id": "media_bg",
      "label": "Media background",
      "default": "#F0EDE8"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR FORMULA:"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made to last. Here's why."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Most fragrances fade within 1 to 2 hours. Thanks to 20% perfume oil, our scent bonds to your skin and releases slowly, hour after hour.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#B17742"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon background",
      "default": "#FDF6EF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "molecule", "label": "Share / molecule" },
            { "value": "clock", "label": "Clock" },
            { "value": "drop", "label": "Drop" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "check", "label": "Check" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "molecule"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon",
          "info": "Overrides the icon above."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Describe the benefit in a sentence."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product mechanism",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "molecule",
            "title": "Bonds to your skin",
            "text": "The high concentration of perfume oil keeps the scent on your skin for longer."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "clock",
            "title": "8+ hours of lasting power",
            "text": "Instead of fading after 1 to 2 hours, the scent releases gradually, all day long."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "drop",
            "title": "Skin-friendly formula",
            "text": "Suitable for daily use and dermatologically tested."
          }
        }
      ]
    }
  ]
}
{% endschema %}
