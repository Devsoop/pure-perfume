{%- liquid
  assign fetch_priority = 'auto'
  assign loading = 'eager'
  if section.index == 1
    assign fetch_priority = 'high'
  elsif section.index > 3
    assign loading = 'lazy'
  endif
-%}

<div
  class="split-hero split-hero--{{ section.settings.layout }}"
  style="
    --split-hero-height: {{ section.settings.desktop_height }}px;
    --split-hero-content-bg: {{ section.settings.content_background }};
    --split-hero-heading: {{ section.settings.heading_color }};
    --split-hero-text: {{ section.settings.text_color }};
    --split-hero-btn-bg: {{ section.settings.button_background }};
    --split-hero-btn-text: {{ section.settings.button_text_color }};
    --split-hero-trust-icon: {{ section.settings.trust_icon_color }};
  "
>
  <div class="split-hero__grid">
    <div class="split-hero__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="split-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="split-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          class="split-hero__button"
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
        >
          <span>{{ section.settings.button_label | escape }}</span>
          {% render 'icon-arrow' %}
        </a>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="split-hero__trust" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_item' and block.settings.text != blank -%}
              <li class="split-hero__trust-item" {{ block.shopify_attributes }}>
                <span class="split-hero__trust-icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'smile' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                        <line x1="9" y1="9" x2="9.01" y2="9"></line>
                        <line x1="15" y1="9" x2="15.01" y2="9"></line>
                      </svg>
                    {%- when 'users' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                      </svg>
                    {%- when 'thumbs_up' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
                      </svg>
                  {%- endcase -%}
                </span>
                <span class="split-hero__trust-label">{{ block.settings.text | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="split-hero__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            widths: '750, 1100, 1500, 2000',
            sizes: '(min-width: 1024px) 50vw, 100vw',
            loading: loading,
            fetchpriority: fetch_priority
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'split-hero__placeholder' }}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-split-hero {
    margin: 0 !important;
  }

  .split-hero {
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .split-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .split-hero--image_second .split-hero__grid {
    grid-template-areas:
      'image'
      'content';
  }

  .split-hero--image_first .split-hero__grid {
    grid-template-areas:
      'image'
      'content';
  }

  .split-hero__content {
    grid-area: content;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 3.2rem 2.4rem;
    background: var(--split-hero-content-bg);
    min-width: 0;
  }

  .split-hero__heading {
    margin: 0;
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--split-hero-heading);
    word-break: break-word;
  }

  .split-hero__text {
    margin: 1.2rem 0 0;
    max-width: 52rem;
    font-size: 1.6rem;
    line-height: 1.5;
    color: var(--split-hero-text);
  }

  .split-hero__text p {
    margin: 0;
  }

  .split-hero__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: 100%;
    box-sizing: border-box;
    margin-top: 2rem;
    padding: 1.6rem 3.2rem;
    border: 2px solid transparent;
    border-radius: 1rem;
    box-shadow: 0 0 0 2px transparent;
    background: var(--split-hero-btn-bg);
    color: var(--split-hero-btn-text);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .split-hero__button:hover,
  .split-hero__button:active,
  .split-hero__button:focus-visible {
    border-color: #fff;
    box-shadow: 0 0 0 2px #111;
    opacity: 1;
  }

  .split-hero__button .icon {
    width: 1.4rem;
    height: 1.4rem;
    flex-shrink: 0;
  }

  .split-hero__trust {
    display: flex;
    align-items: stretch;
    width: 100%;
    max-width: 55rem;
    margin: 2.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .split-hero__trust-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0.8rem;
    min-width: 0;
    padding: 0 1rem;
    text-align: center;
  }

  .split-hero__trust-item + .split-hero__trust-item {
    border-left: 1px solid rgba(18, 18, 18, 0.2);
  }

  .split-hero__trust-icon {
    display: flex;
    width: 2.4rem;
    height: 2.4rem;
    color: var(--split-hero-trust-icon);
  }

  .split-hero__trust-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .split-hero__trust-label {
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--split-hero-text);
  }

  .split-hero__media {
    grid-area: image;
    margin: 0;
    padding: 0;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    min-width: 0;
  }

  .split-hero__media img,
  .split-hero__media svg,
  .split-hero__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
    border-radius: 0;
  }

  .split-hero__placeholder {
    background: #afafaf;
  }

  @media screen and (min-width: 1024px) {
    .split-hero {
      height: var(--split-hero-height);
    }

    .split-hero__grid {
      height: 100%;
    }

    .split-hero--image_second .split-hero__grid {
      grid-template-columns: minmax(0, 1fr) 50%;
      grid-template-areas: 'content image';
    }

    .split-hero--image_first .split-hero__grid {
      grid-template-columns: 50% minmax(0, 1fr);
      grid-template-areas: 'image content';
    }

    .split-hero__content {
      padding: 2.4rem 4.8rem;
      height: 100%;
    }

    .split-hero__heading {
      font-size: 3.6rem;
    }

    .split-hero__text {
      margin-top: 1.6rem;
      font-size: 1.8rem;
    }

    .split-hero__button {
      width: 90%;
      max-width: 90%;
      margin-top: 2.4rem;
      font-size: 1.6rem;
    }

    .split-hero__trust {
      margin-top: 2.8rem;
    }

    .split-hero__trust-item {
      padding: 0 1.6rem;
    }

    .split-hero__trust-label {
      font-size: 1.3rem;
    }

    .split-hero__media {
      aspect-ratio: auto;
      height: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Split hero",
  "class": "section-split-hero",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Smell great without breaking the bank"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Enjoy your favorite perfume, without the price tag."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop image position",
      "options": [
        {
          "value": "image_second",
          "label": "Right"
        },
        {
          "value": "image_first",
          "label": "Left"
        }
      ],
      "default": "image_second"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Desktop height",
      "default": 600
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "Content background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "trust_icon_color",
      "label": "Trust icon",
      "default": "#a43c3f"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "smile", "label": "Smile" },
            { "value": "users", "label": "Customers" },
            { "value": "thumbs_up", "label": "Thumbs up" }
          ],
          "default": "smile"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "100,000+ 5-Star Reviews"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Split hero",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon": "smile",
            "text": "100,000+ 5-Star Reviews"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "users",
            "text": "4 Million Happy Customers"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "thumbs_up",
            "text": "30-Day Money-Back Guarantee"
          }
        }
      ]
    }
  ]
}
{% endschema %}
