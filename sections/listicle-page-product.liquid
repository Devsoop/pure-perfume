                    <p>({{ section.settings.product_review_count }})</p>
                  </div>
                {% endif %}

                {% if section.settings.product_title != blank %}
                  <p class="listicle-page-product__product-card__title">{{ section.settings.product_title }}</p>
                {% endif %}

                {% if section.settings.product_description != blank %}
                  <p class="listicle-page-product__product-card__description">
                    {{ section.settings.product_description }}
                  </p>
                {% endif %}

                {% if section.settings.product_button_label and section.settings.product_button_url %}
                  <div class="listicle-page-product__product-card__button">
                    <a
                      href="{{ section.settings.product_button_url }}"
                    >
                      {{ section.settings.product_button_label }}
                    </a>
                  </div>
                {% endif %}
