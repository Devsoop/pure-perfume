<div
  class="listicle-page-product"
  style="
    --padding-top-desktop: {{ section.settings.padding_top }}px;
    --padding-bottom-desktop: {{ section.settings.padding_bottom }}px;
    --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --background-color: {{ section.settings.background_color }};
    --title-color: {{ section.settings.title_color }};
  "
>
  <div class="listicle-page-product__container">
    <div class="listicle-page-product__layout">
      <div class="listicle-page-product__heading">
        {% if section.settings.title != blank %}
          <h3>{{ section.settings.title }}</h3>
        {% endif %}
        <div class="listicle-page-product__benefits">
          {%- for block in section.blocks -%}
            <div class="listicle-page-product__benefit">
              {% if block.settings.icon != blank %}
                <img
                  src="{{ block.settings.icon | image_url }}"
                  width="22"
                  height="22"
                  alt="{{ block.settings.text | strip_html | escape }}"
                >
              {% endif %}

              <p>{{ block.settings.text }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
      <div class="listicle-page-product__main">
        <div class="listicle-page-product__image">
          {% if section.settings.image != blank %}
            <img
              src="{{ section.settings.image | image_url }}"
              width="424"
              height="424"
              alt="{{ section.settings.product_title | strip_html | escape }}"
            >
          {% endif %}
        </div>
        <div class="listicle-page-product__product">
          {% if section.settings.product_image != blank %}
            <div class="listicle-page-product__product-card">
              <div class="listicle-page-product__product-card__image">
                {% if section.settings.product_badge != blank %}
                  <div class="listicle-page-product__product-card__badge">
                    {{ section.settings.product_badge }}
                  </div>
                {% endif %}
                <img
                  src="{{ section.settings.product_image | image_url }}"
                  width="251"
                  height="251"
                  alt="{{ section.settings.product_title | strip_html | escape }}"
                >
              </div>
              <div class="listicle-page-product__product-card__content">
                {% if section.settings.product_review_count != blank %}
                  <div class="listicle-page-product__product-card__review">
