{%- style -%}
  .faq-ss-{{ section.id }} {
    --faq-bg: {{ section.settings.background }};
    --faq-heading: {{ section.settings.heading_color }};
    --faq-text: {{ section.settings.text_color }};
    --faq-border: {{ section.settings.border_color }};
    background-color: var(--faq-bg);
  }
{%- endstyle -%}

<div class="faq-ss faq-ss-{{ section.id }}" data-faq-section>
  <div class="faq-ss__inner">
    {%- if section.settings.heading != blank -%}
      <div class="faq-ss__heading">
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="faq-ss__body">
      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank -%}
          <details class="faq-ss__item" {{ block.shopify_attributes }}>
            <summary class="faq-ss__toggle">
              <p class="faq-ss__question">{{ block.settings.question | escape }}</p>
              <span class="faq-ss__plus" aria-hidden="true">
                <span class="faq-ss__plus-v"></span>
                <span class="faq-ss__plus-h"></span>
              </span>
            </summary>
            {%- if block.settings.answer != blank -%}
              <div class="faq-ss__answer rte">
                {{ block.settings.answer }}
              </div>
            {%- endif -%}
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign json_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            {%- unless json_index == 0 -%},{%- endunless -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | json }}
              }
            }
            {%- assign json_index = json_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .section-faq {
    margin: 0 !important;
  }

  .faq-ss {
    width: 100%;
  }

  .faq-ss__inner {
    margin: 0 auto;
    padding: 2.1rem 2.4rem;
  }

  .faq-ss__heading {
    text-align: center;
  }

  .faq-ss__heading h2 {
    margin: 0;
    color: var(--faq-heading);
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: 400;
    font-size: 2.4rem;
    line-height: 1.3;
    letter-spacing: normal;
    text-transform: none;
  }

  .faq-ss__body {
    margin-top: 2.4rem;
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: 1.6rem;
  }

  .faq-ss__item {
    position: relative;
    border-bottom: 1px solid var(--faq-border);
    padding-bottom: 1.2rem;
  }

  .faq-ss__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    cursor: pointer;
    list-style: none;
  }

  .faq-ss__toggle::-webkit-details-marker,
  .faq-ss__toggle::marker {
    display: none;
  }

  .faq-ss__question {
    margin: 0;
    flex: 1;
    color: var(--faq-text);
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1.3;
    text-transform: none;
  }

  .faq-ss__plus {
    position: relative;
    display: flex;
    flex: 0 0 1.4rem;
    align-items: center;
    justify-content: center;
    width: 1.4rem;
    height: 1.4rem;
    transition: transform 0.25s ease;
  }

  .faq-ss__plus-v,
  .faq-ss__plus-h {
    position: absolute;
    background-color: var(--faq-border);
    border-radius: 3px;
  }

  .faq-ss__plus-v {
    top: 0;
    left: 50%;
    width: 0.2rem;
    height: 100%;
    transform: translateX(-50%);
    transition: height 0.25s ease;
  }

  .faq-ss__plus-h {
    top: 50%;
    left: 0;
    width: 100%;
    height: 0.2rem;
    transform: translateY(-50%);
  }

  .faq-ss__item[open] .faq-ss__plus {
    transform: rotate(180deg);
  }

  .faq-ss__item[open] .faq-ss__plus-v {
    height: 0;
  }

  .faq-ss__answer {
    overflow: hidden;
    padding-top: 1.2rem;
  }

  .faq-ss__answer,
  .faq-ss__answer p,
  .faq-ss__answer li {
    margin: 0;
    color: var(--faq-text);
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    line-height: 1.4;
    text-transform: none;
  }

  .faq-ss__answer p {
    min-height: 1rem;
  }

  .faq-ss__answer p + p {
    margin-top: 1rem;
  }

  .faq-ss__answer strong {
    font-weight: 700;
  }

  @media screen and (min-width: 1024px) {
    .faq-ss__inner {
      padding: 2.8rem 8rem;
    }

    .faq-ss__heading h2 {
      font-size: 3.8rem;
    }

    .faq-ss__body {
      margin-top: 6rem;
      gap: 3rem;
    }

    .faq-ss__item {
      padding-bottom: 1.6rem;
    }

    .faq-ss__question {
      font-size: 1.8rem;
    }

    .faq-ss__answer,
    .faq-ss__answer p,
    .faq-ss__answer li {
      font-size: 1.6rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener(
    'toggle',
    (event) => {
      const item = event.target;
      if (!(item instanceof HTMLDetailsElement)) return;
      if (!item.classList.contains('faq-ss__item') || !item.open) return;

      const root = item.closest('[data-faq-section]');
      if (!root) return;

      root.querySelectorAll('details.faq-ss__item[open]').forEach((other) => {
        if (other !== item) other.open = false;
      });
    },
    true
  );
{% endjavascript %}

