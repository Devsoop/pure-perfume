{%- style -%}
  .customer-results-{{ section.id }} {
    --cr-bg: {{ section.settings.background }};
    --cr-heading: {{ section.settings.heading_color }};
    --cr-stat: {{ section.settings.stat_color }};
    --cr-text: {{ section.settings.text_color }};
    --cr-pad-top: {{ section.settings.padding_top }}px;
    --cr-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="customer-results customer-results-{{ section.id }}">
  <div class="customer-results__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="customer-results__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="customer-results__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <div class="customer-results__grid">
      {%- for block in section.blocks -%}
        <div class="customer-results__card" {{ block.shopify_attributes }}>
          {%- if block.settings.stat != blank -%}
            {%- liquid
              assign stat_raw = block.settings.stat | strip
              assign stat_number = stat_raw | replace: '%', '' | replace: ',', '.' | split: '/' | first | times: 1
              assign has_percent = false
              if stat_raw contains '%'
                assign has_percent = true
              endif
            -%}
            <p
              class="customer-results__stat"
              data-cr-stat
              data-target="{{ stat_number }}"
              data-suffix="{% if has_percent %}%{% endif %}"
              data-original="{{ stat_raw | escape }}"
            >
              {% if has_percent %}0%{% else %}{{ stat_raw | escape }}{% endif %}
            </p>
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            <p class="customer-results__label">{{ block.settings.label | escape }}</p>
          {%- endif -%}
          {%- if block.settings.rating > 0 -%}
            <div class="customer-results__stars" aria-label="{{ block.settings.rating }} out of 5">
              {%- for i in (1..5) -%}
                <span class="customer-results__star{% if i > block.settings.rating %} is-empty{% endif %}" aria-hidden="true">★</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .customer-results {
    background: var(--cr-bg);
    padding: var(--cr-pad-top) 0 var(--cr-pad-bottom);
  }

  .customer-results__heading {
    margin: 0;
    text-align: center;
    color: var(--cr-heading);
    font-size: clamp(2rem, 3vw, 2.8rem);
    font-weight: 500;
    line-height: 1.25;
  }

  .customer-results__subheading {
    margin: 0.8rem auto 0;
    max-width: 52rem;
    text-align: center;
    color: var(--cr-text);
    font-size: 1.5rem;
    line-height: 1.4;
  }

  .customer-results__grid {
    margin-top: 3.2rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .customer-results__card {
    text-align: center;
    padding: 2rem 1.2rem;
  }

  .customer-results__stat {
    margin: 0 0 1rem;
    color: var(--cr-stat);
    font-size: clamp(3.6rem, 6vw, 5.6rem);
    font-weight: 400;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .customer-results__label {
    margin: 0;
    color: var(--cr-text);
    font-size: 1.45rem;
    line-height: 1.4;
  }

  .customer-results__stars {
    margin-top: 1rem;
    color: #00b67a;
    font-size: 1.8rem;
    letter-spacing: 0.1em;
  }

  .customer-results__star.is-empty {
    color: rgba(0, 0, 0, 0.15);
  }

  @media screen and (max-width: 749px) {
    .customer-results__grid {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.querySelector('.customer-results-{{ section.id }}');
    if (!root || root.dataset.crBound) return;
    root.dataset.crBound = 'true';

    var stats = root.querySelectorAll('[data-cr-stat]');
    if (!stats.length) return;

    function animateStat(el, duration) {
      var target = parseFloat(el.getAttribute('data-target'));
      var suffix = el.getAttribute('data-suffix') || '';
      var original = el.getAttribute('data-original') || '';

      if (!target || isNaN(target) || !suffix) {
        el.textContent = original;
        return;
      }

      var start = 0;
      var startTime = null;
      var end = Math.round(target);

      function frame(now) {
        if (!startTime) startTime = now;
        var progress = Math.min((now - startTime) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        var value = Math.round(start + (end - start) * eased);
        el.textContent = value + suffix;
        if (progress < 1) requestAnimationFrame(frame);
        else el.textContent = end + suffix;
      }

      el.textContent = '0' + suffix;
      requestAnimationFrame(frame);
    }

    function run() {
      stats.forEach(function (el) {
        animateStat(el, 1100);
      });
    }

    if (!('IntersectionObserver' in window)) {
      run();
      return;
    }

    var seen = false;
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            run();
            seen = true;
          } else if (seen) {
            stats.forEach(function (el) {
              var suffix = el.getAttribute('data-suffix') || '';
              if (suffix) el.textContent = '0' + suffix;
            });
          }
        });
      },
      { threshold: 0.45 }
    );

    observer.observe(root);
  })();
</script>

{% schema %}
{
  "name": "Customer results",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer results & ratings"
