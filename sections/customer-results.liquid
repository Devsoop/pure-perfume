    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real feedback from people who switched to Pure Parfum."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "stat_color",
      "label": "Stat color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#444444"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "result",
      "name": "Result",
      "settings": [
        {
          "type": "text",
          "id": "stat",
          "label": "Stat",
          "default": "4.8/5"
        },
        {
          "type": "textarea",
          "id": "label",
          "label": "Label",
          "default": "Average customer rating"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer results",
      "blocks": [
        {
          "type": "result",
          "settings": {
            "stat": "92%",
            "label": "Would choose this over their usual designer brand",
            "rating": 5
          }
        },
        {
          "type": "result",
          "settings": {
            "stat": "98%",
            "label": "Said the scent smelled just like the designer fragrance",
            "rating": 5
          }
        },
        {
          "type": "result",
          "settings": {
            "stat": "95%",
            "label": "Said the scent lasted all day without reapplying",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
