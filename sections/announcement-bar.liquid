{%- if section.blocks.size > 0 -%}
  <div
    class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} utility-bar--bottom-border{% endif %}"
  >
    <announcement-marquee
      class="announcement-marquee{% if section.settings.pause_on_hover %} announcement-marquee--pause{% endif %}"
      data-speed="{{ section.settings.speed }}"
      role="region"
      aria-label="{{ 'sections.header.announcement' | t }}"
    >
      <div class="announcement-marquee__track" data-marquee-track>
        <div class="announcement-marquee__group" data-marquee-source>
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank -%}
              <div class="announcement-marquee__item" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a class="announcement-marquee__text" href="{{ block.settings.link }}">
                    {{- block.settings.text | escape -}}
                  </a>
                {%- else -%}
                  <span class="announcement-marquee__text">
                    {{- block.settings.text | escape -}}
                  </span>
                {%- endif -%}
              </div>
              <span class="announcement-marquee__separator" aria-hidden="true">·</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </announcement-marquee>
  </div>
{%- endif -%}

<style>
  .announcement-marquee {
    display: block;
    width: 100%;
    overflow: hidden;
    padding: 0.6rem 0.8rem;
    color: rgb(var(--color-foreground));
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
  }

  .announcement-marquee__track {
    display: flex;
    align-items: center;
    width: max-content;
    max-width: none;
    animation: announcement-marquee-scroll var(--marquee-time, 40s) linear infinite;
  }

  .announcement-marquee--pause:hover .announcement-marquee__track,
  .announcement-marquee--pause:focus-within .announcement-marquee__track {
    animation-play-state: paused;
  }

  .announcement-marquee__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .announcement-marquee__item {
    display: flex;
    align-items: center;
    padding: 0 1.6rem;
  }

  .announcement-marquee__text {
    color: inherit;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.2rem;
    line-height: 1.4;
    font-weight: inherit;
  }

  .announcement-marquee__text:hover {
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .announcement-marquee__separator {
    padding: 0 0.8rem;
    opacity: 0.3;
    font-size: 1.2rem;
    line-height: 1;
    font-weight: inherit;
  }

  @media screen and (max-width: 749px) {
    .announcement-marquee {
      padding: 0.5rem 0.4rem;
    }

    .announcement-marquee__item {
      padding: 0 1.2rem;
    }

    .announcement-marquee__separator {
      padding: 0 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-marquee__track {
      animation: none;
      width: 100%;
      justify-content: center;
    }
  }

  @keyframes announcement-marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-1 * var(--marquee-width)));
    }
  }
</style>

<script>
  if (!customElements.get('announcement-marquee')) {
    class AnnouncementMarquee extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-marquee-track]');
        this.source = this.querySelector('[data-marquee-source]');
        if (!this.track || !this.source) return;

        this.reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.setup = this.setup.bind(this);
        this.setup();

        this.resizeObserver = new ResizeObserver(this.setup);
        this.resizeObserver.observe(this);
        this.reduceMotion.addEventListener('change', this.setup);

        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(this.setup);
        }
      }

      disconnectedCallback() {
        this.resizeObserver?.disconnect();
        this.reduceMotion?.removeEventListener('change', this.setup);
      }

      setup() {
        if (!this.track || !this.source) return;

        this.track.querySelectorAll('[data-marquee-clone]').forEach((clone) => clone.remove());

        if (this.reduceMotion.matches) {
          this.track.style.removeProperty('--marquee-width');
          this.track.style.removeProperty('--marquee-time');
          return;
        }

        const speed = Number(this.dataset.speed) || 30;
        const originalWidth = this.source.scrollWidth;

        if (!originalWidth) return;

        this.track.style.setProperty('--marquee-width', `${originalWidth}px`);
        this.track.style.setProperty('--marquee-time', `${originalWidth / speed}s`);

        let hasCloned = false;
        while (this.track.scrollWidth <= this.clientWidth * 2 || !hasCloned) {
          const clone = this.source.cloneNode(true);
          clone.removeAttribute('data-marquee-source');
          clone.setAttribute('data-marquee-clone', '');
          clone.setAttribute('aria-hidden', 'true');
          clone.querySelectorAll('a').forEach((link) => {
            link.setAttribute('tabindex', '-1');
          });
          this.track.appendChild(clone);
          hasCloned = true;
          if (this.track.children.length > 16) break;
        }
      }
    }

    customElements.define('announcement-marquee', AnnouncementMarquee);
  }
</script>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Scroll speed",
      "default": 30,
      "info": "Higher values scroll faster"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "default": true,
      "label": "Pause on hover"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__1.content",
      "info": "t:sections.announcement-bar.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__3.content",
      "info": "t:sections.announcement-bar.settings.header__3.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__4.content",
      "info": "t:sections.announcement-bar.settings.header__4.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Welcome to our store",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
