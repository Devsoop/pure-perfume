{%- liquid
  assign products_to_show = section.settings.products_to_show
  assign collection = section.settings.collection
  assign columns_desktop = 3
  assign product_count = 0

  if collection != blank and collection.products_count > 0
    assign product_count = collection.products_count
    if product_count > products_to_show
      assign product_count = products_to_show
    endif
  else
    assign product_count = 6
  endif

  assign enable_desktop_slider = false
  if product_count > columns_desktop
    assign enable_desktop_slider = true
  endif
-%}

<div
  class="bestsellers-grid"
  style="
    --bs-heading: {{ section.settings.heading_color }};
    --bs-title: {{ section.settings.title_color }};
    --bs-sale: {{ section.settings.sale_color }};
    --bs-compare: {{ section.settings.compare_color }};
    --bs-insp-bg: {{ section.settings.inspiration_background }};
    --bs-insp-text: {{ section.settings.inspiration_color }};
    --bs-pad-top: {{ section.settings.padding_top }}px;
    --bs-pad-bottom: {{ section.settings.padding_bottom }}px;
    --bs-cols: {{ columns_desktop }};
    --bs-gap: 2.4rem;
  "
>
  <slider-component class="bestsellers-grid__inner">
    <div class="bestsellers-grid__header">
      {%- if section.settings.title != blank -%}
        <h2 class="bestsellers-grid__heading">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if enable_desktop_slider -%}
        <div class="bestsellers-grid__nav">
          <button
            type="button"
            class="bestsellers-grid__nav-btn bestsellers-grid__nav-btn--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            {% render 'icon-arrow' %}
          </button>
          <button
            type="button"
            class="bestsellers-grid__nav-btn bestsellers-grid__nav-btn--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            {% render 'icon-arrow' %}
          </button>
        </div>
      {%- endif -%}
    </div>

    <ul
      id="Slider-{{ section.id }}"
      class="bestsellers-grid__list{% if enable_desktop_slider %} bestsellers-grid__list--slider{% endif %}"
      role="list"
      {% if enable_desktop_slider %}
        aria-label="{{ 'general.slider.name' | t }}"
      {% endif %}
    >
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: products_to_show -%}
          {%- liquid
            assign display_title = product.title
            assign inspiration = ''

            if product.metafields.custom.tagline != blank
              assign inspiration = product.metafields.custom.tagline.value | default: product.metafields.custom.tagline | strip
            elsif product.metafields.custom.inspiration != blank
              assign inspiration = product.metafields.custom.inspiration.value | default: product.metafields.custom.inspiration | strip
            elsif product.metafields.custom.inspired_by != blank
              assign inspiration = product.metafields.custom.inspired_by.value | default: product.metafields.custom.inspired_by | strip
            endif

            if inspiration == blank
              assign title_parts = product.title | split: ' - '
              assign maybe_insp = title_parts | first | strip
              if maybe_insp contains 'Inspired by' or maybe_insp contains 'Geïnspireerd'
                assign inspiration = maybe_insp
                assign display_title = product.title | remove_first: 'Inspired by ' | remove_first: 'Geïnspireerd door ' | strip
              endif
            endif

            assign price_min = product.price_min
            assign compare_min = product.compare_at_price_min
            assign on_sale = false
            if compare_min != blank and compare_min > price_min
              assign on_sale = true
            endif

            assign money_price = price_min | money
            assign money_compare = compare_min | money

            if product.price_varies
              assign money_price = 'products.product.price.from_price_html' | t: price: money_price
            endif
          -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="bestsellers-grid__item"
          >
            <a class="bestsellers-card" href="{{ product.url }}">
              <div class="bestsellers-card__media">
                {%- if product.featured_media -%}
                  {{
                    product.featured_media
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 1000, 1200',
                      sizes: '(min-width: 1000px) 33vw, 50vw',
                      alt: product.featured_media.alt
                  }}
                {%- else -%}
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'bestsellers-card__placeholder' }}
                {%- endif -%}
              </div>

              <div class="bestsellers-card__info">
                <span class="bestsellers-card__title">{{ display_title | escape }}</span>

                {%- if inspiration != blank -%}
                  <span class="bestsellers-card__inspiration">{{ inspiration | escape }}</span>
                {%- endif -%}

                <div class="bestsellers-card__price">
                  {%- if on_sale -%}
                    <span class="bestsellers-card__price-sale">{{ money_price }}</span>
                    <s class="bestsellers-card__price-compare">{{ money_compare }}</s>
                  {%- else -%}
                    <span class="bestsellers-card__price-regular">{{ money_price }}</span>
                  {%- endif -%}
                </div>
              </div>
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="bestsellers-grid__item"
          >
            <div class="bestsellers-card">
              <div class="bestsellers-card__media">
                {{ 'product-apparel-' | append: forloop.index | placeholder_svg_tag: 'bestsellers-card__placeholder' }}
              </div>
              <div class="bestsellers-card__info">
                <span class="bestsellers-card__title">{{ 'onboarding.product_title' | t }}</span>
                <span class="bestsellers-card__inspiration">Inspired by Designer Fragrance</span>
                <div class="bestsellers-card__price">
                  <span class="bestsellers-card__price-sale">{{ 1999 | money }}</span>
                  <s class="bestsellers-card__price-compare">{{ 2999 | money }}</s>
                </div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </slider-component>
</div>

{% stylesheet %}
  .section-bestsellers-grid {
    margin: 0 !important;
  }

  .bestsellers-grid {
    width: 100%;
    padding: calc(var(--bs-pad-top) * 0.75) 2rem calc(var(--bs-pad-bottom) * 0.75);
    background: #fff;
  }

  .bestsellers-grid__inner {
    display: block;
    width: 100%;
    max-width: none;
    margin: 0;
  }

  .bestsellers-grid__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    margin: 0 0 3.2rem;
  }

  h2.bestsellers-grid__heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: 3.2rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.08rem;
    color: var(--bs-heading);
  }

  .bestsellers-grid__nav {
    display: none;
    flex-shrink: 0;
    align-items: center;
    gap: 0.8rem;
  }

  .bestsellers-grid__nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    padding: 0;
    border: 1px solid #121212;
    background: #fff;
    color: #121212;
    cursor: pointer;
  }

  .bestsellers-grid__nav-btn .icon {
    width: 1.4rem;
    height: 1rem;
  }

  .bestsellers-grid__nav-btn--prev .icon {
    transform: rotate(180deg);
  }

  .bestsellers-grid__nav-btn:hover:not([disabled]) {
    background: #121212;
    color: #fff;
  }

  .bestsellers-grid__nav-btn[disabled] {
    opacity: 0.28;
    cursor: not-allowed;
  }

  .bestsellers-grid__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.2rem;
    row-gap: 3.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bestsellers-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--bs-title);
  }

  .bestsellers-card:hover {
    color: var(--bs-title);
  }

  .bestsellers-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f7f7f7;
  }

  .bestsellers-card__media img,
  .bestsellers-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bestsellers-card__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 2.4rem;
    gap: 0.4rem;
  }

  .bestsellers-card__title {
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 2.4rem;
    letter-spacing: 0;
    color: var(--bs-title);
  }

  .bestsellers-card__inspiration {
    display: block;
    width: 100%;
    margin: 0 0 0.8rem;
    padding: 1rem;
    background: var(--bs-insp-bg);
    color: var(--bs-insp-text);
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-style: italic;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.01em;
    text-align: center;
  }

  .bestsellers-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.8rem;
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0;
  }

  .bestsellers-card__price-sale {
    color: var(--bs-sale);
  }

  .bestsellers-card__price-regular {
    color: var(--bs-title);
  }

  .bestsellers-card__price-compare {
    color: var(--bs-compare);
    text-decoration: line-through;
  }

  @media screen and (min-width: 750px) {
    .bestsellers-grid {
      padding: var(--bs-pad-top) 4.8rem var(--bs-pad-bottom);
    }

    .bestsellers-grid__header {
      margin-bottom: 4.8rem;
    }

    h2.bestsellers-grid__heading {
      font-size: 4rem;
      line-height: 4.4rem;
    }

    .bestsellers-grid__nav {
      display: flex;
    }

    .bestsellers-grid__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2.4rem;
      row-gap: 4.8rem;
    }

    .bestsellers-grid__list--slider {
      display: flex;
      flex-wrap: nowrap;
      gap: var(--bs-gap);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .bestsellers-grid__list--slider::-webkit-scrollbar {
      display: none;
    }

    .bestsellers-grid__list--slider .bestsellers-grid__item {
      flex: 0 0 calc((100% - (var(--bs-cols) - 1) * var(--bs-gap)) / var(--bs-cols));
      width: calc((100% - (var(--bs-cols) - 1) * var(--bs-gap)) / var(--bs-cols));
      max-width: calc((100% - (var(--bs-cols) - 1) * var(--bs-gap)) / var(--bs-cols));
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bestsellers grid",
  "class": "section-bestsellers-grid",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Bestsellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 6,
      "label": "Products to show"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Product title",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "sale_color",
      "label": "Sale price",
      "default": "#f83a3a"
    },
    {
      "type": "color",
      "id": "compare_color",
      "label": "Compare-at price",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "inspiration_background",
      "label": "Inspiration background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "inspiration_color",
      "label": "Inspiration text",
      "default": "#ef776b"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Bestsellers grid"
    }
  ]
}
{% endschema %}
