{% comment %}
  Renders the payment icon list shared by the product page and cart drawer.

  Accepts:
  - class: {string} class for the list (optional, defaults to 'product-payment-icons')

  Usage:
  {% render 'payment-icons', class: 'cart-drawer__payment-icons' %}
{% endcomment %}

{%- assign list_class = class | default: 'product-payment-icons' -%}
<ul class="{{ list_class }} list-unstyled" role="list" aria-label="Payment methods">
  {%- assign payment_types = 'american_express,apple_pay,bancontact,diners_club,discover,google_pay,master,paypal,shopify_pay,visa' | split: ',' -%}
  {%- for type in payment_types -%}
    <li class="{{ list_class }}__item">
      {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
    </li>
  {%- endfor -%}
</ul>
