    "faq": {
      "type": "faq",
      "blocks": {
        "faq_1": {
          "type": "question",
          "settings": {
            "question": "Do your perfumes smell the same as the designer fragrances they're inspired by?",
            "answer": "<p>Our perfumes are <strong>inspired by popular designer fragrances</strong> and share a scent profile in the same direction. Many customers say our scents remind them of their favorites — but they remain unique interpretations, never the originals.</p>"
          }
        },
        "faq_2": {
          "type": "question",
          "settings": {
            "question": "How do I know the quality is good for the price?",
            "answer": "<p>We save on expensive marketing, packaging, and brand markup — <strong>not on fragrance quality</strong>. We use premium ingredients for a luxury scent experience.</p>"
          }
        },
        "faq_3": {
          "type": "question",
          "settings": {
            "question": "How long does the scent last?",
            "answer": "<p>It depends on the fragrance and your skin type, but on average our eau de parfum stays noticeable for about 10 to 12 hours.</p>"
          }
        },
        "faq_4": {
          "type": "question",
          "settings": {
            "question": "What about delivery?",
            "answer": "<p>We typically ship within 24 hours. Delivery usually takes 1–3 business days. Once shipped, you'll automatically receive a track &amp; trace code.</p>"
          }
        },
        "faq_5": {
          "type": "question",
          "settings": {
            "question": "Are your products vegan and cruelty-free?",
            "answer": "<p>Yes. All of our perfumes are 100% vegan, free from animal ingredients, and not tested on animals.</p>"
          }
        }
      },
